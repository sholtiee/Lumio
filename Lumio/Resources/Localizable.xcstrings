      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка…"
          }
        }
      }
    },
    "Connect an external display to adjust it here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите внешний монитор, чтобы настроить его здесь."
