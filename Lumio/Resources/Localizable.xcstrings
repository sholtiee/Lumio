      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumio"
          }
        }
      }
    },
    "Lumio remembers your choice for each display and restores it whenever the display is connected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumio запоминает выбор для каждого дисплея и восстанавливает его при подключении."
          }
        }
      }
    },
    "Main display": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной дисплей"
          }
        }
      }
    },
    "Mirror": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повтор экрана"
          }
        }
      }
    },
    "More space": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше места"
          }
        }
