    "%lld Hz": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Гц"
          }
        }
      }
    },
    "1:1, sharpest": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1:1, максимально чётко"
          }
        }
      }
    },
    "About Lumio": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О Lumio"
          }
        }
      }
    },
    "Accessibility access granted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ разрешён"
          }
        }
      }
    },
    "Accessibility access is needed for media keys and moving windows": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен Универсальный доступ — для медиаклавиш и переноса окон"
          }
        }
      }
    },
    "Adjusts the monitor's backlight over DDC/CI.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет подсветку монитора через DDC/CI."
          }
